REDIS_PORT=6379

# Backend Application & Prisma Configuration
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://vaultcore_admin:CHANGE_ME_USE_OPENSSL_RAND_BASE64_32@127.0.0.1:5432/vaultcore_ledger?schema=public"
REDIS_URL="redis://:CHANGE_ME_USE_OPENSSL_RAND_BASE64_32@127.0.0.1:6379"

# 32-byte (64 hex characters) Master Key for AES-256-GCM Field-Level Encryption
# Generate with: openssl rand -hex 32
