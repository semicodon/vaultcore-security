# Database Configuration
POSTGRES_USER=vaultcore_admin
POSTGRES_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32
POSTGRES_DB=vaultcore_ledger
POSTGRES_PORT=5432

# Redis Configuration (Session & Rate Limiting)
